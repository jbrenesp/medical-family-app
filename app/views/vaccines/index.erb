<div class="container mt-4">
  <h1>Vaccines for <%= @family_member.name %></h1>

  <% if @vaccines.any? %>
    <ul class="list-group mt-3">
      <% @vaccines.each do |vaccine| %>
        <li class="list-group-item">
          <%= link_to vaccine.name, family_family_member_vaccine_path(@family, @family_member, vaccine) %>
          — Date of vaccination: <%= format_date(vaccine.vaccine_date) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mt-3">No vaccines recorded yet.</p>
  <% end %>

  <div class="border-top pt-3 mt-3">
    <div class="d-flex flex-column flex-md-row gap-2">
    <%= link_to 'Add vaccines', new_family_family_member_vaccine_path(@family, @family_member), class: "btn btn-success" %>
    <%= link_to 'Back', family_family_member_path(@family, @family_member), class: "btn btn-secondary" %>
    </div>
  </div>
</div>
<div class="container mt-4">

  <h1>Vaccine Details</h1>

  <div class="card p-3 mt-3">
    <p><strong>Family Member:</strong> <%= link_to @family_member.name, family_family_member_path(@family, @family_member) %></p>
    <p><strong>Name:</strong> <%= @vaccine.name %></p>
    <p><strong>Date:</strong> <%= format_date(@vaccine.vaccine_date) %></p>
    <p><strong>Next due date:</strong> <%= @vaccine.next_due_date.present? ? format_date(@vaccine.next_due_date) : "Not entered yet" %></p>
    <p><strong>Dose number:</strong> <%= @vaccine.dose_number %></p>
    <p><strong>Notes:</strong> <%= @vaccine.notes %></p>
    
  </div>

  <div class="border-top pt-3 mt-3">
    <div class="d-flex flex-column flex-md-row gap-2">
    <%= link_to "Edit", edit_family_family_member_vaccine_path(@family, @family_member, @vaccine),
        class: "btn btn-warning" %>
    <%= link_to 'Delete', family_family_member_vaccine_path(@family, @family_member, @vaccine), 
    data: { "turbo-method": :delete, "turbo-confirm": "Are you sure?" }, class: "btn btn-danger" %>

    <%= link_to "Back to Vaccines", family_family_member_vaccines_path(@family, @family_member),
        class: "btn btn-secondary" %>
    </div>
  </div>

</div>
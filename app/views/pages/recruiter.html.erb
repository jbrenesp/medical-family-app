<%# app/views/pages/recruiter.html.erb %>

<div class="container mt-3">
  <div class="row justify-content-center">
    <div class="col-md-4">
      <div class="card p-3 border-primary h-100">
        <h5 class="mb-2 text-center">👋 Welcome, Recruiter!</h5>
        <p class="text-center text-muted mb-2">Try the app with the demo account below:</p>
        <table class="table table-sm mb-0">
          <tbody>
            <tr>
              <td><strong>Email</strong></td>
              <td>demo@example.com</td>
            </tr>
            <tr>
              <td><strong>Password</strong></td>
              <td>Demo2026!</td>
            </tr>
          </tbody>
        </table>
        <p class="text-center text-muted mb-2">Feel free to make any changes.</p>
      </div>
      
    </div>

    <div class="col-md-4">
      <div class="card p-3 h-100">
        <h5 class="mb-3 text-center">Sign In</h5>
        <%= form_with url: user_session_path, method: :post do |form| %>
          <div class="mb-2">
            <%= form.label :email, class: "form-label" %>
            <%= form.email_field "user[email]", class: "form-control form-control-sm", required: true %>
          </div>
          <div class="mb-2">
            <%= form.label :password, class: "form-label" %>
            <%= form.password_field "user[password]", class: "form-control form-control-sm", required: true %>
          </div>
          <%= form.submit "Sign In", class: "btn btn-primary btn-sm w-100 mt-1" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
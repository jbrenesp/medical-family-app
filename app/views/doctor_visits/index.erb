<div class="container mt-4">
  <h1>Doctor Visits for <%= @family_member.name %></h1>

  <% if @doctor_visits.any? %>
    <ul class="list-group mt-3">
      <% @doctor_visits.each do |doctor_visit| %>
        <li class="list-group-item">
          <%= link_to doctor_visit.doctor_name, family_family_member_doctor_visit_path(@family, @family_member, doctor_visit) %>
          — Date: <%= format_date(doctor_visit.visit_date) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mt-3">No doctor visits recorded yet.</p>
  <% end %>

  <div class="border-top pt-3 mt-3">
    <div class="d-flex flex-column flex-md-row gap-2">
    <%= link_to 'Add Doctor Visit', new_family_family_member_doctor_visit_path(@family, @family_member), class: "btn btn-success" %>
    <%= link_to 'Back', family_family_member_path(@family, @family_member), class: "btn btn-secondary" %>
    </div>
  </div>
</div>
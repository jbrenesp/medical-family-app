<div class="container mt-4">

  <h1>Doctor Visit Details</h1>

  <div class="card p-3 mt-3">
    <p><strong>Family Member:</strong> <%= @family_member.name %></p>
    <p><strong>Doctor name:</strong> <%= @doctor_visit.doctor_name %></p>
    <p><strong>City:</strong> <%= @doctor_visit.doctor_city %></p>
    <p><strong>Visit date:</strong> <%= @doctor_visit.visit_date %></p>
    <p><strong>Visit type:</strong> <%= @doctor_visit.visit_type %></p>
    <p><strong>Notes:</strong> <%= @doctor_visit.notes %></p>
    
  </div>

  <div class="mt-3">
    <%= link_to "Edit", edit_family_family_member_doctor_visit_path(@family_member, @family_member, @doctor_visit),
        class: "btn btn-warning" %>
    <%= link_to 'Delete', family_family_member_doctor_visit_path(@family, @family_member, @doctor_visit), 
    data: { "turbo-method": :delete, "turbo-confirm": "Are you sure?" }, class: "btn btn-danger" %>

    <%= link_to "Back", family_family_member_path(@family, @family_member),
        class: "btn btn-secondary" %>
  </div>

</div>
<div class="container mt-4">
  <h1>Checkups for <%= @family_member.name %></h1>

  <% if @checkups.any? %>
    <ul class="list-group mt-3">
      <% @checkups.each do |checkup| %>
        <li class="list-group-item">
          <%= link_to checkup.checkup_type, family_family_member_checkup_path(@family, @family_member, checkup) %>
          — Date: <%= format_date(checkup.date) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mt-3">No checkups recorded yet.</p>
  <% end %>

  <div class="border-top pt-3 mt-3">
    <div class="d-flex flex-column flex-md-row gap-2">
    <%= link_to 'Add Checkup', new_family_family_member_checkup_path(@family, @family_member), class: "btn btn-success" %>
    <%= link_to 'Back', family_family_member_path(@family, @family_member), class: "btn btn-secondary" %>
    </div>
  </div>
</div>
<div class="container mt-4">
  <h1>Edit Checkup for <%= @family_member.name %></h1>

  <%= form_with model: [@family, @family_member, @checkup] do |form| %>

    <% if @checkup.errors.any? %>
      <div class="alert alert-danger">
        <% @checkup.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :checkup_type, class: "form-label" %>
      <%= form.select :checkup_type, ['blood_test', 'general', 'dental', 'vision', 'other'], {}, class: "form-select" %>
    </div>

    <div class="mb-3">
      <%= form.label :date, class: "form-label" %>
      <%= form.date_field :date, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :results, class: "form-label" %>
      <%= form.text_area :results, class: "form-control" %>
    </div>

    
    <div class="mb-3">
      <%= form.label :notes, class: "form-label" %>
      <%= form.text_area :notes, class: "form-control" %>
    </div>


    

    <%= form.submit "Update Checkup", class: "btn btn-primary" %>

    <%= link_to 'Cancel', family_family_member_checkup_path(@family, @family_member, @checkup), class: "btn btn-secondary mt-2" %>

  <% end %>
</div>
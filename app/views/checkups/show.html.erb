<div class="container mt-4">

  <h1>Checkup Details</h1>

  <div class="card p-3 mt-3">
    <p><strong>Family Member:</strong> <%= @family_member.name %></p>
    <p><strong>Checkup type:</strong> <%= @checkup.checkup_type %></p>
    <p><strong>Date:</strong> <%= format_date(@checkup.date) %></p>
    <p><strong>Results:</strong> <%= @checkup.results %></p>
    <p><strong>Notes:</strong> <%= @checkup.notes %></p>
    
    
  </div>

  <div class="mt-3">
    <%= link_to "Edit", edit_family_family_member_checkup_path(@family, @family_member, @checkup),
        class: "btn btn-warning" %>
    <%= link_to 'Delete', family_family_member_checkup_path(@family, @family_member, @checkup), 
    data: { "turbo-method": :delete, "turbo-confirm": "Are you sure?" }, class: "btn btn-danger" %>

    <%= link_to "Back", family_family_member_checkups_path(@family, @family_member),
        class: "btn btn-secondary" %>
  </div>

</div>
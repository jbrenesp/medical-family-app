<div class="container mt-4 pb-5">

  <div class="card border shadow-sm p-4 mb-3" style="border-radius: 12px;">
    <h1 class="h3 mb-1"><%= @family_member.name %></h1>
    <p class="text-muted mb-3"><%= @family_member.member_type %></p>
    <p class="mb-1"><strong>Blood Type:</strong> <%= @family_member.blood_type %></p>
    <p class="mb-0"><strong>Date of Birth:</strong> <%= format_date(@family_member.date_of_birth) %></p>
    <p></p>
    <% @upcoming_visits.each do |visit| %>
      <p class="mb-2">
        <strong>Doctor Visit:</strong>
        <%= link_to visit.doctor_name, family_family_member_doctor_visit_path(@family, @family_member, visit) %>
        — <%= visit.visit_type %> — <%= format_date(visit.visit_date) %> — <strong>Pending</strong>
      </p>
    <% end %>

    <% @active_illnesses.each do |illness| %>
      <p class="mb-2">
        <strong>Illness:</strong>
        <%= link_to illness.name, family_family_member_illness_path(@family, @family_member, illness) %>
        — Started: <%= format_date(illness.start_date) %>
        — <% if illness.end_date.present? %>
            Ended: <%= format_date(illness.end_date) %>
          <% else %>
            <strong>Still active</strong>
          <% end %>
      </p>
    <% end %>

    <% @active_medications.each do |medication| %>
      <p class="mb-2">
        <strong>Medication:</strong>
        <%= link_to medication.name, family_family_member_medication_path(@family, @family_member, medication) %>
        — <%= medication.medication_type %>
        — Started: <%= format_date(medication.start_date) %>
        — <% if medication.end_date.present? %>
            Ended: <%= format_date(medication.end_date) %>
          <% else %>
            <strong>Still active</strong>
          <% end %>
      </p>
    <% end %>
  </div>

  

  <div class="d-flex gap-2 flex-wrap mt-2 mb-4">
    <%= link_to 'Illnesses', family_family_member_illnesses_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Doctor Visits', family_family_member_doctor_visits_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Medications', family_family_member_medications_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Allergies', family_family_member_allergies_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Vaccines', family_family_member_vaccines_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Checkups', family_family_member_checkups_path(@family, @family_member), class: "btn btn-outline-primary" %>
  </div>

  <div class="border-top pt-3 pb-4">
    <div class="d-flex flex-column flex-md-row justify-content-md-between gap-2">
      <%= link_to 'Back to Family', family_path(@family), class: "btn btn-secondary" %>
      <div class="d-flex flex-column flex-md-row gap-2">
        <%= link_to 'Edit', edit_family_family_member_path(@family, @family_member), class: "btn btn-warning" %>
        <%= link_to 'Delete', family_family_member_path(@family, @family_member), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
      </div>
    </div>
  </div>

</div>
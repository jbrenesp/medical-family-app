<div class="container mt-4">
  <h1><%= @family_member.name %></h1>
  <p><strong>Type:</strong> <%= @family_member.member_type %></p>
  <p><strong>Blood Type:</strong> <%= @family_member.blood_type %></p>
  <p><strong>Date of Birth:</strong> <%= @family_member.date_of_birth %></p>

  <% @active_illnesses.each do |illness| %>
    <p><strong>Illness:</strong> <%= link_to illness.name, family_family_member_illness_path(@family, @family_member, illness) %> — Started: <%= illness.start_date %></p>
  <% end %>

  <% @upcoming_visits.each do |visit| %>
    <p><strong>Doctor Visit:</strong> <%= link_to visit.doctor_name, family_family_member_doctor_visit_path(@family, @family_member, visit) %> — <%= visit.visit_type %> — <%= visit.visit_date %><strong> Pending</strong></p>
  <% end %>

  <% @active_medications.each do |medication| %>
    <p><strong>Medication:</strong> <%= link_to medication.name, family_family_member_medication_path(@family, @family_member, medication) %> — <%= medication.medication_type %> — Started: <%= medication.start_date %></p>
  <% end %>

  <hr>

  <div class="d-flex gap-2 flex-wrap mt-2">
    <%= link_to 'Illnesses', family_family_member_illnesses_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Doctor Visits', family_family_member_doctor_visits_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Medications', family_family_member_medications_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Allergies', family_family_member_allergies_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Vaccines', family_family_member_vaccines_path(@family, @family_member), class: "btn btn-outline-primary" %>
    <%= link_to 'Checkups', family_family_member_checkups_path(@family, @family_member), class: "btn btn-outline-primary" %>
  </div>

  <div class="mt-3">
    <%= link_to 'Edit', edit_family_family_member_path(@family, @family_member), class: "btn btn-warning" %>
    <%= link_to 'Delete', family_family_member_path(@family, @family_member), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
    <%= link_to 'Back to Family', family_path(@family), class: "btn btn-secondary" %>
  </div>

</div>
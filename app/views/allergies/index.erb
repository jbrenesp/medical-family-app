<div class="container mt-4">
  <h1>Allergies for <%= @family_member.name %></h1>

  <% if @allergies.any? %>
    <ul class="list-group mt-3">
      <% @allergies.each do |allergy| %>
        <li class="list-group-item">
          <%= link_to allergy.name, family_family_member_allergy_path(@family, @family_member, allergy) %>
          — Diagnosed Date: <%= allergy.diagnosed_date %>
          — Severity: <%= allergy.severity  %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mt-3">No allergies recorded yet.</p>
  <% end %>

  <div class="mt-3">
    <%= link_to 'Add Medication', new_family_family_member_allergy_path(@family, @family_member), class: "btn btn-success" %>
    <%= link_to 'Back', family_family_member_path(@family, @family_member), class: "btn btn-secondary" %>
  </div>
</div>
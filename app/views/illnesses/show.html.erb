<div class="container mt-4">

  <h1>Illness Details</h1>

  <div class="card p-3 mt-3">
    <p><strong>Name:</strong> <%= @illness.name %></p>
    <p><strong>Notes:</strong> <%= @illness.notes %></p>
    <p><strong>Start Date:</strong> <%= @illness.start_date %></p>
    <p><strong>End Date:</strong> <%= @illness.end_date.present? ? @illness.end_date : "Not entered yet" %></p></p>
    <p><strong>Family Member:</strong> <%= @family_member.name %></p>
  </div>

  <div class="mt-3">
    <%= link_to "Edit", edit_family_family_member_illness_path(@family_member.family, @family_member, @illness),
        class: "btn btn-warning" %>
    <%= link_to 'Delete', family_family_member_illness_path(@family, @family_member, @illness), 
    data: { "turbo-method": :delete, "turbo-confirm": "Are you sure?" }, class: "btn btn-danger" %>

    <%= link_to "Back", family_family_member_path(@family_member.family, @family_member),
        class: "btn btn-secondary" %>
  </div>

</div>
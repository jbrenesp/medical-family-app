<div class="container mt-4">
  <h1>Illnesses for <%= @family_member.name %></h1>

  <% if @illnesses.any? %>
    <ul class="list-group mt-3">
      <% @illnesses.each do |illness| %>
        <li class="list-group-item">
          <%= link_to illness.name, family_family_member_illness_path(@family, @family_member, illness) %>
          — Started: <%= illness.start_date %>
          — <%= illness.end_date.present? ? "Ended: #{illness.end_date}" : "Still active" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mt-3">No illnesses recorded yet.</p>
  <% end %>

  <div class="mt-3">
    <%= link_to 'Add Illness', new_family_family_member_illness_path(@family, @family_member), class: "btn btn-success" %>
    <%= link_to 'Back', family_family_member_path(@family, @family_member), class: "btn btn-secondary" %>
  </div>
</div>
<div class="container mt-4">
  <h1><%= @illness.name %></h1>
  <p>Start Date: <%= @illness.start_date %></p>
  <p>End Date: <%= @illness.end_date %></p>
  <p>Notes: <%= @illness.notes %></p>

  <%= link_to 'Edit', edit_family_family_member_illness_path(@family, @family_member, @illness), class: "btn btn-warning" %>
  <%= link_to 'Delete', family_family_member_illness_path(@family, @family_member, @illness), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
  <%= link_to 'Back to Family Member', family_family_member_path(@family, @family_member), class: "btn btn-secondary" %>
</div>
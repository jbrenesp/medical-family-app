<div class="container mt-4">
  <h1>Edit <%= @illness.name %></h1>

  <%= form_with model: [@family, @family_member, @illness] do |form| %>
    <% if @illness.errors.any? %>
      <div class="alert alert-danger">
        <% @illness.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>


    <div class="mb-3">
      <%= form.label :start_date, class: "form-label" %>
      <%= form.date_field :start_date, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :end_date, class: "form-label" %>
      <%= form.date_field :end_date, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :notes, class: "form-label" %>
      <%= form.text_area :notes, class: "form-control" %>
    </div>

    <%= form.submit "Update illness", class: "btn btn-primary" %>
  <% end %>

  <%= link_to 'Cancel', family_family_member_illness_path(@family, @family_member, @illness), class: "btn btn-secondary mt-2" %>
</div>
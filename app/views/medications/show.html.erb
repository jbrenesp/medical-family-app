<div class="container mt-4">

  <h1>Medication Details</h1>

  <div class="card p-3 mt-3">
    <p><strong>Family Member:</strong> <%= link_to @family_member.name, family_family_member_path(@family, @family_member) %></p>
    <p><strong>Name:</strong> <%= @medication.name %></p>
    <p><strong>Medication type:</strong> <%= @medication.medication_type %></p>
    <p><strong>Start date:</strong> <%= format_date(@medication.start_date) %></p>
    <p><strong>End Date:</strong> <%= @medication.end_date.present? ? format_date(@medication.end_date) : "Not entered yet" %></p>
    <p><strong>Related Illness:</strong>
      <% if @medication.illness %>
        <%= link_to @medication.illness.name,
              family_family_member_illness_path(@family, @family_member, @medication.illness) %>
      <% else %>
        Not assigned
      <% end %>
    </p>
    <p><strong>Notes:</strong> <%= @medication.notes %></p>
    
  </div>

  <div class="border-top pt-3 mt-3">
    <div class="d-flex flex-column flex-md-row gap-2">
    <%= link_to "Edit", edit_family_family_member_medication_path(@family, @family_member, @medication),
        class: "btn btn-warning" %>
    <%= link_to 'Delete', family_family_member_medication_path(@family, @family_member, @medication), 
    data: { "turbo-method": :delete, "turbo-confirm": "Are you sure?" }, class: "btn btn-danger" %>

    <%= link_to "Back to Medications", family_family_member_medications_path(@family, @family_member),
        class: "btn btn-secondary" %>
    </div>
  </div>

</div>
<div class="container mt-4">
  <h1>Medications for <%= @family_member.name %></h1>

  <% if @medications.any? %>
    <ul class="list-group mt-3">
      <% @medications.each do |medication| %>
        <li class="list-group-item">
          <%= link_to medication.name, family_family_member_medication_path(@family, @family_member, medication) %>
          — Start Date: <%= format_date(medication.start_date) %>
          — <%= medication.end_date.present? ? "Ended: #{format_date(medication.end_date)}" : "Still active" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mt-3">No medications recorded yet.</p>
  <% end %>

  <div class="mt-3">
    <%= link_to 'Add Medication', new_family_family_member_medication_path(@family, @family_member), class: "btn btn-success" %>
    <%= link_to 'Back', family_family_member_path(@family, @family_member), class: "btn btn-secondary" %>
  </div>
</div>